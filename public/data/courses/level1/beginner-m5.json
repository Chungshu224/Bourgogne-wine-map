      "slides": [
        {
          "type": "title",
          "title": "夏布利的獨特風土",
          "subtitle": "15分鐘",
          "description": "夏布利位於布根地最北端，距離巴黎僅2小時車程，但卻與金丘有著截然不同的風土條件。這裡的霞多麗展現了最純淨、最礦物感的一面。"
        },
        {
          "type": "map",
          "title": "🗺️ 夏布利產區地圖",
          "interactive": false,
          "mapConfig": {
            "center": [3.8, 47.82],
