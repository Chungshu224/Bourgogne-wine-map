            {
              "id": "chablis",
              "url": "/geojson/Chablis/AOC Chablis.geojson",
              "displayName": "Chablis",
              "fillColor": "#F0E68C",
              "fillOpacity": 0.6,
              "lineColor": "#DAA520",
              "lineWidth": 2,
              "showLabels": true
            }
          ]
        },
        {
          "type": "content",
          "title": "地理位置與氣候",
          "content": "夏布利位於約訥省（Yonne），Serein 河蜿蜒流過，形成理想的山谷地形。氣候屬於大陸性，比金丘更冷，春季霜凍是最大威脅。",
          "keyPoints": [
            "📍 緯度：北緯47.8度，布根地最北端",
            "🌡️ 年均溫：10.5°C（比伯恩丘低2°C）",
            "💧 降雨：750mm，分佈均勻",
            "❄️ 霜凍：春季4-5月是關鍵期",
            "🔥 防霜措施：暖爐、灑水系統",
            "☀️ 日照：夏季日照時數長，利於成熟",
            "🗺️ 距離：巴黎2小時，第戎1.5小時"
          ]
        },
        {
          "type": "content",
          "title": "神奇的 Kimmeridgian 土壤",
          "content": "夏布利最獨特的是1.5億年前侏羅紀時期形成的 Kimmeridgian 泥灰岩，富含小牡蠣化石（Exogyra virgula）。這種土壤賦予夏布利酒款獨特的礦物感和「槍石」（gunflint）香氣。",
          "keyPoints": [
            "🪨 成分：泥灰岩 + 石灰岩 + 貝殼化石",
            "💧 排水：良好，避免根部積水",
            "⚗️ 礦物質：鈣、鎂、碘豐富",
            "👑 特級園：100% Kimmeridgian 土壤",
            "👃 風味影響：牡蠣、貝殼、白堊、燧石",
            "🌍 地質年代：侏羅紀晚期（1.5億年前）",
            "🦪 化石：小牡蠣 Exogyra virgula",
            "📍 分佈：同樣土壤也在香檳區和英國南部"
          ]
        },
        {
          "type": "content",
          "title": "Kimmeridgian 土壤的魔力",
          "content": "這種獨特土壤如何影響夏布利的風味？",
          "keyPoints": [
            "🎯 核心特徵",
            "  • 高鈣質含量：提供礦物骨架",
            "  • 泥灰岩結構：保水但排水良好",
            "  • 化石成分：釋放海洋礦物質",
            "",
            "👃 風味表現",
            "  • 牡蠣殼、海鹽、濕石頭",
            "  • 槍石（打火石）、白堊",
            "  • 檸檬皮、青蘋果",
            "",
            "🔬 科學解釋",
            "  • 化石含量越高，礦物感越明顯",
            "  • 葡萄根吸收特定礦物質",
            "  • 涼爽氣候保留高酸度"
          ]
        },
        {
          "type": "content",
          "title": "夏布利 vs 金丘霞多麗",
          "content": "同樣是霞多麗，為何風格截然不同？",
          "keyPoints": [
            "🌡️ 氣候：夏布利涼爽大陸性 vs 金丘溫和",
            "🪨 土壤：Kimmeridgian 泥灰岩 vs 石灰岩為主",
            "🍷 釀造：少過桶或不過桶 vs 橡木桶發酵/陳年",
            "👃 香氣：檸檬、牡蠣、礦物 vs 奶油、榛果、熱帶水果",
            "💪 酒體：輕盈到中等 vs 中等到飽滿",
            "😋 口感：高酸清爽 vs 圓潤豐富",
            "💰 價格：€15-200 vs €30-500+",
            "🍽️ 配餐：生蠔海鮮 vs 奶油醬汁禽肉"
          ]
        },
        {
          "type": "chart",
          "chartType": "radar",
          "title": "📊 夏布利 vs 金丘霞多麗風格對比",
          "content": "同樣的霞多麗品種，不同風土造就截然不同的風格",
          "data": {
            "dimensions": ["酒體", "酸度", "礦物感", "果味濃度", "橡木桶", "陳年潛力"],
            "datasets": [
              {
                "label": "夏布利 Chablis",
                "color": "#4CAF50",
                "opacity": 0.3,
                "values": [5, 9, 10, 6, 2, 7]
              },
              {
                "label": "金丘白酒 Côte d'Or",
                "color": "#FFD700",
                "opacity": 0.3,
                "values": [8, 7, 5, 8, 9, 9]
              }
            ]
          },
          "note": "評分範圍 0-10。夏布利以高酸度和礦物感著稱，金丘白酒則更飽滿圓潤，橡木桶使用更多。"
        },
        {
          "type": "content",
          "title": "霜凍的挑戰",
          "content": "春季霜凍是夏布利最大的自然威脅，嚴重時可摧毀50%以上產量。",
          "keyPoints": [
            "❄️ 霜凍原因",
            "  • 4-5月氣溫驟降至0°C以下",
            "  • 新芽最脆弱，極易凍傷",
            "  • 2017、2018年霜凍損失超50%",
            "",
            "🔥 防霜措施",
            "  • 暖爐（Bougies）：燃燒蠟燭/油",
            "  • 灑水系統：結冰保護芽點",
            "  • 風扇攪動：混合空氣層",
            "  • 煙霧：形成保護層",
            "",
            "💰 經濟影響",
            "  • 產量銳減，價格上漲",
            "  • 2017年份極度稀少",
            "  • 酒農投入巨額防霜設備"
          ]
        },
        {
          "type": "list",
          "title": "💡 重點提示",
          "points": [
            "🌊 Kimmeridgian 得名自英國 Dorset 郡的 Kimmeridge 村",
            "🌊 同樣的土壤也出現在香檳區和英國南部",
            "🌊 化石含量越高，礦物感越明顯",
            "🌊 2017、2018年霜凍導致產量減少50%以上",
            "🌊 夏布利只種植霞多麗，是單一品種產區",
            "🌊 Serein 河調節微氣候，降低霜凍風險"
          ]
        },
        {
          "type": "content",
          "title": "總結",
          "content": "夏布利的涼爽氣候和獨特的 Kimmeridgian 土壤，造就了世界上最純淨、最具礦物感的霞多麗白酒。這是風土影響的最佳範例，證明了葡萄酒不只是品種和釀造，更是土地和氣候的表達。"
        }
      ]
    },
